// Users with an active session (local or xrdp) may start only printer-center-update.service
// without a password, via the "Check for updates" button.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "printer-center-update.service" &&
        action.lookup("verb") == "start" && subject.active) {
        return polkit.Result.YES;
    }
});

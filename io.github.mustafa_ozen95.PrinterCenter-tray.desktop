[Desktop Entry]
Type=Application
Name=Printer Center (notification area)
Comment=Starts Printer Center in the notification area at login
Comment[tr]=Oturum açılınca Printer Center'ı bildirim alanında başlatır
Exec=/usr/bin/python3 /opt/printer-center/printer_center_gui.py --tray
Icon=printer
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
X-MATE-Autostart-Delay=5
